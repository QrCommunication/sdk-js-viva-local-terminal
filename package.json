{
  "name": "@qrcommunication/viva-local-terminal-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Viva.com Local Terminal API (/pos/v1/) — peer-to-peer (P2P) communication directly with an EFT POS terminal over the LAN. No cloud, no authentication, self-signed TLS aware.",
  "keywords": [
    "viva",
    "viva.com",
    "vivapayments",
    "eft-pos",
    "terminal",
    "local-terminal",
    "p2p",
    "payments",
    "card-present",
    "pos",
    "sdk",
    "api",
    "typescript"
  ],
  "homepage": "https://github.com/QrCommunication/sdk-js-viva-local-terminal",
  "bugs": {
    "url": "https://github.com/QrCommunication/sdk-js-viva-local-terminal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QrCommunication/sdk-js-viva-local-terminal.git"
  },
  "license": "MIT",
  "author": {
    "name": "QrCommunication",
    "email": "contact@qrcommunication.com",
    "url": "https://qrcommunication.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
